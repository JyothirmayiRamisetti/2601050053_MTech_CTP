GST_RATE = 18.0
DISCOUNT_RATE = 10.0

# product name -> {"price": price, "quantity": quantity}
cart = {}


def display_cart():
    print("\n================ SHOPPING CART ================")

    if not cart:
        print("Cart is empty.")
        print("================================================\n")
        return

    print(f"{'Product':20} {'Price':>10} {'Qty':>6} {'Amount':>12}")
    print("-" * 52)

    for name, product in cart.items():
        amount = product["price"] * product["quantity"]
        print(
            f"{name[:20]:20} "
            f"Rs.{product['price']:>7.2f} "
            f"{product['quantity']:>6} "
            f"Rs.{amount:>9.2f}"
        )

    print("================================================\n")


def add_product():
    print("\n============= ADD PRODUCT =============")

    name = input("Enter product name: ").strip()

    if not name:
        print("Product name cannot be empty.")
        return

    try:
        price = float(input("Enter product price: Rs."))
        quantity = int(input("Enter quantity: "))
    except ValueError:
        print("Please enter valid price and quantity.")
        return

    if price < 0 or quantity <= 0:
        print("Price cannot be negative and quantity must be positive.")
        return

    if name in cart:
        cart[name]["quantity"] += quantity
    else:
        cart[name] = {
            "price": price,
            "quantity": quantity
        }

    print(f"{quantity} x {name} added to cart.\n")


def remove_product():
    print("\n============ REMOVE PRODUCT ============")

    if not cart:
        print("Cart is empty.\n")
        return

    name = input("Enter product name to remove: ").strip()

    if name not in cart:
        print("Product not found in cart.\n")
        return

    del cart[name]
    print(f"{name} removed successfully.\n")


def change_quantity():
    print("\n=========== CHANGE QUANTITY ===========")

    if not cart:
        print("Cart is empty.\n")
        return

    name = input("Enter product name: ").strip()

    if name not in cart:
        print("Product not found in cart.\n")
        return

    try:
        quantity = int(input("Enter new quantity (0 to remove): "))
    except ValueError:
        print("Please enter a valid quantity.")
        return

    if quantity < 0:
        print("Quantity cannot be negative.")
        return

    if quantity == 0:
        del cart[name]
        print(f"{name} removed from cart.\n")
    else:
        cart[name]["quantity"] = quantity
        print(f"Quantity updated for {name}.\n")


def calculate_subtotal():
    return sum(
        product["price"] * product["quantity"]
        for product in cart.values()
    )


def calculate_discount(subtotal):
    if subtotal >= 1000:
        return subtotal * DISCOUNT_RATE / 100
    return 0


def calculate_gst(amount_after_discount):
    return amount_after_discount * GST_RATE / 100


def display_final_bill():
    print("\n================ FINAL BILL ================")

    if not cart:
        print("Cart is empty.")
        print("============================================\n")
        return

    subtotal = calculate_subtotal()
    discount = calculate_discount(subtotal)
    taxable_amount = subtotal - discount
    gst = calculate_gst(taxable_amount)
    final_amount = taxable_amount + gst

    display_cart()

    print(f"Subtotal          : Rs.{subtotal:.2f}")
    print(f"Discount          : Rs.{discount:.2f}")
    print(f"Amount after disc. : Rs.{taxable_amount:.2f}")
    print(f"GST ({GST_RATE:.0f}%)          : Rs.{gst:.2f}")
    print("--------------------------------------------")
    print(f"FINAL BILL        : Rs.{final_amount:.2f}")
    print("============================================\n")


def main():
    while True:
        print("""
========= ONLINE SHOPPING CART =========
1. Add product
2. Remove product
3. Change quantity
4. Display cart
5. Display final bill
6. Exit
=========================================
""")

        choice = input("Enter your choice: ").strip()

        if choice == "1":
            add_product()
        elif choice == "2":
            remove_product()
        elif choice == "3":
            change_quantity()
        elif choice == "4":
            display_cart()
        elif choice == "5":
            display_final_bill()
        elif choice == "6":
            print("Thank you for using the Online Shopping Cart System.")
            break
        else:
            print("Invalid choice. Please try again.\n")


if __name__ == "__main__":
    main()
